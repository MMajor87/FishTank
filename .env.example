# FishTank configuration. Copy to .env and edit:   cp .env.example .env
# Every value below is an example. See README.md for what each one does.

# ---- App ----
# Public origin(s) allowed to make state-changing requests (comma-separated). The first one is
# also used to build invite links. Use your public HTTPS URL in production.
# Local-only test without a domain: APP_ORIGIN=http://localhost:3080 and COOKIE_SECURE=false
APP_ORIGIN=https://fishtank.example.com

# Trust X-Forwarded-For only from the reverse proxy on the fishtank-edge network.
TRUST_PROXY=10.88.1.0/24

# Session length in days (sliding).
SESSION_DAYS=30

# Session cookies are Secure (HTTPS only) unless this is "false". Only turn it off for local tests.
# COOKIE_SECURE=false

# Time zone for logs and backup filenames (IANA name).
TZ=UTC

# ---- Tanks ----
# Separate origin for Tank browsers (isolates them from the app's cookies).
TANK_ORIGIN=https://tanks.example.com
# Hostname or IP viewers use to reach the WebRTC UDP ports. Resolved to one IPv4 address each
# time a Tank starts, so a dynamic-DNS name works.
TANK_PUBLIC_HOST=example.com
# One UDP port per Tank; forward this range from your router to the Docker host.
TANK_UDP_PORTS=59000-59009
MAX_TANKS=4
TANKS_PER_HOST=1
TANK_CPUS=6
TANK_MEMORY_GB=3
TANK_IDLE_MINUTES=15
TANK_MAX_HOURS=8
# Minutes between home-page screenshot previews of each Tank (0 = off). Kept in memory only.
TANK_PREVIEW_MINUTES=10
# Neko browser image and stream resolution.
# TANK_IMAGE=ghcr.io/m1k1o/neko/firefox:3
# TANK_SCREEN=1280x720@30
# LAN services Tanks may reach (ip:port, TCP, space-separated). Everything else private is blocked.
# Leave empty to block all private addresses.
TANK_ALLOW_DESTINATIONS=
# Example: TANK_ALLOW_DESTINATIONS=192.168.1.50:8096 192.168.1.50:32400
# Tiles on each Tank browser's start page + bookmarks bar (JSON). LAN addresses must also be
# listed in TANK_ALLOW_DESTINATIONS to work.
TANK_START_TILES=[{"title":"YouTube","url":"https://www.youtube.com/"},{"title":"Twitch","url":"https://www.twitch.tv/"}]
# Example with a LAN media server:
# TANK_START_TILES=[{"title":"YouTube","url":"https://www.youtube.com/"},{"title":"Jellyfin","url":"http://192.168.1.50:8096/"}]
# Sites where the Tank browser's tracking protection and uBlock Origin are off (space-separated
# domains). Twitch's login is rejected as "unsupported browser" otherwise.
TANK_TRUSTED_SITES=twitch.tv
# Tanks have no GPU; WebGL would report a software renderer, which login bot checks flag.
# "vendor|renderer" the Tank's Firefox reports instead (empty = report the real one).
TANK_WEBGL_GPU=NVIDIA Corporation|NVIDIA GeForce RTX 3070/PCIe/SSE2
# Tank browser time zone (defaults to TZ). Should match where your public IP is.
TANK_TIMEZONE=America/New_York

# ---- Recording (optional, off by default; see docs/RECORDING.md) ----
# Admins can record a Tank; every account can watch recordings until they are wiped.
# Set BOTH to turn it on: COMPOSE_PROFILES starts the recorder container, RECORDING_ENABLED turns
# on the app and firewall side.
# COMPOSE_PROFILES=recording
# RECORDING_ENABLED=true
# Days after a recording ends before it is wiped.
# RECORDING_KEEP_DAYS=7
# Longest single recording, in hours (defaults to TANK_MAX_HOURS).
# RECORDING_MAX_HOURS=8
# Encoder settings (2500 kbps ≈ 1.2 GB per hour). Apply to Tanks opened after a change.
# RECORDING_VIDEO_KBPS=2500
# RECORDING_AUDIO_KBPS=128
# RECORDING_PRESET=veryfast
# Where recordings are stored. Empty = the fishtank-recordings Docker volume (inside Docker's own
# disk). Set a host folder to use another drive, e.g. D:/FishTank/recordings (Windows) or
# /mnt/big/fishtank-recordings (Linux). On Linux the folder must be writable by uid 1000.
# Move existing recordings yourself when changing it (stop app + recorder, copy raw/ and ready/).
# RECORDINGS_PATH=
# Refuse to start a recording below this much free disk space.
# RECORDING_MIN_FREE_GB=10
# Length of a clip ("Clip the last minute"), in seconds.
# RECORDING_CLIP_SECONDS=60
# Tanks play recordings shared to them ("Watch together") from this address of the app.
# Only change it if you changed the Docker subnets (also update APP_PLAYBACK_ADDRESS in compose).
# RECORDING_TANK_URL=http://10.88.2.2:3001

# ---- Backups ----
BACKUP_DIR=/backups
BACKUP_KEEP=14
